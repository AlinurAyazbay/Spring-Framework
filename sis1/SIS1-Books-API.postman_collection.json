    {
      "name": "Paged queries (Practice 4.1)",
      "item": [
        {
          "name": "15. Paged: first page (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Has content and page block\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"content\"); pm.expect(j).to.have.property(\"page\"); });",
                  "pm.test(\"Page size is 5\", function () { pm.expect(pm.response.json().page.size).to.eql(5); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/paged?page=0&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "paged"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
